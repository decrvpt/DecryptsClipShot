<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ClipShotReplayParser</AssemblyName>
    <RootNamespace>DecryptsClipShot.ReplayParser</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Weapon codename → display name table. Edit this each season. -->
    <EmbeddedResource Include="weapons.json" LogicalName="weapons.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FortniteReplayReader" Version="3.0.1" />
  </ItemGroup>
</Project>
