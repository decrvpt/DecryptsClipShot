<Window x:Class="DecryptsClipShot.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take a screenshot" Width="1000" Height="700" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Take a screenshot" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Move to the moment you want, then click Save screenshot. Find kill streaks and Find damage number jump to where each is most visible. Arrow keys move one frame."
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="Black" CornerRadius="10">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                          Stretch="Uniform" MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Slider x:Name="PositionSlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="1" VerticalAlignment="Center"
                    ValueChanged="PositionSlider_ValueChanged"/>
            <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00.000" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="PlayButton" Content="Play" Style="{StaticResource SecondaryButton}" MinWidth="80" Click="Play_Click"/>
            <Button Content="◀ Frame" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="PreviousFrame_Click" ToolTip="One frame back (Left arrow)"/>
            <Button Content="Frame ▶" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="NextFrame_Click" ToolTip="One frame forward (Right arrow)"/>
            <Button x:Name="FindKillButton" Content="Find kill streaks" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="FindKill_Click"/>
            <Button x:Name="FindDamageButton" Content="Find damage number" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="FindDamage_Click"/>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenFolderButton" Content="Open screenshots" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OpenFolder_Click"/>
                <Button x:Name="SaveButton" Content="Save screenshot" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
