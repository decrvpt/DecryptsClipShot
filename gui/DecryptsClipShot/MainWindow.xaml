<Window x:Class="DecryptsClipShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Decrypt's ClipShot" Width="1220" Height="790"
        MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen"
        Icon="/Assets/clipshot-red.ico" PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource PageBrush}">
    <Window.Resources>
        <DataTemplate x:Key="LeaderboardRowTemplate">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RankText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DistanceText}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WeaponLine}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding VictimLine}" Style="{StaticResource CardHint}" TextTrimming="CharacterEllipsis"/>
                            <Border Visibility="{Binding BotVisibility}" Background="#2A2A30" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Bot" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource CardHint}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="3" Content="{Binding WatchText}" IsEnabled="{Binding ClipExists}" Style="{StaticResource SecondaryButton}" Padding="14,8" VerticalAlignment="Center" Click="LeaderboardWatch_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ClipCardTemplate">
            <Border Width="252" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,16" Padding="10" Cursor="Hand"
                    ToolTip="Double-click to watch">
                <StackPanel>
                    <Grid Height="132">
                        <Border Background="#1F1F23" CornerRadius="8" ClipToBounds="True">
                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#B0000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▶" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Border>
                        <Border Background="#CC0B0B0D" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                            <TextBlock Text="{Binding Category}" Foreground="#F2A3A6" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="4,11,4,0" TextTrimming="CharacterEllipsis"/>
                    <!-- Trickshot details from the replay. -->
                    <StackPanel Visibility="{Binding KillInfoVisibility}" Margin="4,6,4,0">
                        <TextBlock Text="{Binding KillWeaponLine}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding KillPlayersLine}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding KillRarity}" Foreground="{Binding KillRarityBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,6,4,3"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ScreenshotCardTemplate">
            <Border Width="252" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,16,16" Padding="10" Cursor="Hand"
                    ToolTip="Double-click to open">
                <StackPanel>
                    <Border Height="132" Background="#1F1F23" CornerRadius="8" ClipToBounds="True">
                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="4,10,4,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,4,4,3"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#1F1F23" BorderThickness="1" Background="{StaticResource PageBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#09090B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Image Width="24" Height="24" Source="/Assets/clipshot-logo-transparent.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Decrypt's ClipShot" FontWeight="SemiBold" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource CaptionButton}" FontSize="15" Click="MaximizeRestore_Click" ToolTip="Maximize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#232327" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="22,26,18,30">
                            <Image Width="46" Height="46" Source="/Assets/clipshot-logo-transparent.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ClipShot" FontSize="21" FontWeight="Bold"/>
                                <TextBlock Text="by Decrypt" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Click="DashboardNav_Click" Tag="Active">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Width="28" FontSize="16"/><TextBlock Text="Dashboard"/></StackPanel>
                            </Button>
                            <Button x:Name="ClipsNav" Style="{StaticResource NavButton}" Click="ClipsNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▶" Width="28" FontSize="13"/><TextBlock Text="My Clips"/></StackPanel>
                            </Button>
                            <Button x:Name="ScreenshotsNav" Style="{StaticResource NavButton}" Click="ScreenshotsNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="28" FontSize="15"/><TextBlock Text="Screenshots"/></StackPanel>
                            </Button>
                            <Button x:Name="LeaderboardNav" Style="{StaticResource NavButton}" Click="LeaderboardNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="▲" Width="28" FontSize="13"/><TextBlock Text="Furthest Shots"/></StackPanel>
                            </Button>
                            <Button x:Name="ReplayAnalyzerNav" Style="{StaticResource NavButton}" Click="ReplayAnalyzerNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="◎" Width="28" FontSize="16"/><TextBlock Text="Meter Checker"/></StackPanel>
                            </Button>
                            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="28" FontSize="16"/><TextBlock Text="Settings"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" Background="#141417" BorderBrush="#232327" BorderThickness="1" CornerRadius="10" Margin="14" Padding="14,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SidebarStatusDot" Width="9" Height="9" Fill="#67677A" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SidebarStatusText" Text="Off" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="HotkeyHintText" Text="F8 saves a clip" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="18,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="34,27,34,30">
                    <Grid x:Name="DashboardPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header: page title and live status pill. -->
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Decrypt's ClipShot" Style="{StaticResource CardHint}" FontSize="12"/>
                                <TextBlock Text="Home" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#67677A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeaderStatusText" Text="Off" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                                    <TextBlock x:Name="HeaderHotkeysText" Text="F8 clip  ·  F9 long  ·  F10 screenshot" Style="{StaticResource CardHint}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Welcome card: who, what's happening, the main actions. -->
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="24,22" Margin="0,0,12,12">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.85,0.15" GradientOrigin="0.85,0.15" RadiusX="0.9" RadiusY="1.1">
                                            <GradientStop Color="#2A1517" Offset="0"/>
                                            <GradientStop Color="#141417" Offset="0.65"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="CaptureStateText" Text="ClipShot is off" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock x:Name="FpsMetric" Visibility="Collapsed"/>
                                            <TextBlock x:Name="QualityMetric" Visibility="Collapsed"/>
                                            <TextBlock x:Name="ClipLengthMetric" Visibility="Collapsed"/>
                                            <TextBlock x:Name="CaptureSubtext" Text="Click Start ClipShot to begin recording" Style="{StaticResource CardHint}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Status list, like a system overview. -->
                                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal"><Ellipse x:Name="RecStatusDot" Width="7" Height="7" Fill="#67677A" VerticalAlignment="Center"/><TextBlock Text="Recording" FontSize="12.5" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock x:Name="RecStatusValue" Text="Off" Style="{StaticResource CardHint}" FontSize="12" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal"><Ellipse x:Name="GameAudioStatusDot" Width="7" Height="7" Fill="#67677A" VerticalAlignment="Center"/><TextBlock Text="Game sound" FontSize="12.5" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock x:Name="GameAudioStatusValue" Text="Off" Style="{StaticResource CardHint}" FontSize="12" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal"><Ellipse x:Name="MicStatusDot" Width="7" Height="7" Fill="#67677A" VerticalAlignment="Center"/><TextBlock Text="Microphone" FontSize="12.5" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock x:Name="MicStatusValue" Text="Off" Style="{StaticResource CardHint}" FontSize="12" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal"><Ellipse x:Name="FortniteStatusDot" Width="7" Height="7" Fill="#67677A" VerticalAlignment="Center"/><TextBlock Text="Fortnite" FontSize="12.5" Margin="10,0,0,0"/></StackPanel>
                                                <TextBlock x:Name="FortniteStatusValue" Text="Not running" Style="{StaticResource CardHint}" FontSize="12" HorizontalAlignment="Right" ToolTip="Fortnite is only needed for automatic trickshot clips and the Meter Checker. Everything else works with any game."/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,18,0,0">
                                            <Border x:Name="LongRecordBadge" Visibility="Collapsed" Background="#33E5484D" CornerRadius="8" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#E5484D" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="LongRecordText" Text="Long recording 00:00:00" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="3" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button x:Name="EngineButton" Content="Start ClipShot" Style="{StaticResource PrimaryButton}" Padding="16,12" Click="EngineButton_Click"/>
                                            <Button x:Name="SaveClipButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="16,12" Click="SaveClip_Click" IsEnabled="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Save clip" VerticalAlignment="Center"/>
                                                    <Border Background="#26262B" CornerRadius="5" Padding="6,1" Margin="10,0,0,0">
                                                        <TextBlock x:Name="HotkeyMetric" Text="F8" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Recent clips / activity. -->
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Height="260">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="RecentTabButton" Content="Recent clips" Style="{StaticResource LinkButton}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Click="RecentTab_Click"/>
                                                <Button x:Name="ActivityTabButton" Content="Activity" Style="{StaticResource LinkButton}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="18,0,0,0" Click="ActivityTab_Click"/>
                                            </StackPanel>
                                            <Button x:Name="RecentSideButton" Content="See all →" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClipsNav_Click"/>
                                            <Button x:Name="ActivitySideButton" Content="Clear" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearActivity_Click" Visibility="Collapsed"/>
                                        </Grid>
                                        <Grid x:Name="RecentClipsPanel" Grid.Row="1">
                                            <ListBox x:Name="RecentClipsList" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="White" MouseDoubleClick="ClipList_MouseDoubleClick">
                                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="64" Height="36" Background="#1F1F23" CornerRadius="6" ClipToBounds="True"><Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <!-- Shown until the first clip exists. -->
                                            <StackPanel Margin="0,14,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasItems, ElementName=RecentClipsList}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Get your first clip" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,0,0,7"><Run Text="1" Foreground="#E5484D" FontWeight="Bold"/><Run Text="   ClipShot records in the background while you play"/></TextBlock>
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,0,0,7"><Run Text="2" Foreground="#E5484D" FontWeight="Bold"/><Run Text="   Press your clip shortcut after a great moment"/></TextBlock>
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5"><Run Text="3" Foreground="#E5484D" FontWeight="Bold"/><Run Text="   Fortnite trickshots are clipped for you automatically"/></TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <ListBox x:Name="ActivityList" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- Long recording and screenshots. -->
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Long recording" Style="{StaticResource CardLabel}"/>
                                                <TextBlock x:Name="LongHotkeyMetric" Text="F9" Style="{StaticResource CardHint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="Record everything until you stop, for YouTube videos" Style="{StaticResource CardHint}" Margin="0,3,0,12" TextWrapping="Wrap"/>
                                            <Button x:Name="LongRecordButton" Content="Start long recording" Style="{StaticResource SecondaryButton}" Padding="14,9" Click="LongRecord_Click" IsEnabled="False"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Screenshots" Style="{StaticResource CardLabel}"/>
                                                <TextBlock x:Name="ShotHotkeyMetric" Text="F10" Style="{StaticResource CardHint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="ScreenshotCountText" Text="Saved in your Pictures folder" Style="{StaticResource CardHint}" Margin="0,3,0,12" TextWrapping="Wrap"/>
                                            <Button Content="View screenshots" Style="{StaticResource SecondaryButton}" Padding="14,9" Click="ScreenshotsNav_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Quick settings switches. -->
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Quick settings" Style="{StaticResource CardLabel}" Margin="0,0,0,14"/>
                                        <CheckBox x:Name="QuickStartOnOpenSwitch" Content="Start recording when ClipShot opens" Style="{StaticResource SwitchToggle}" Margin="0,0,0,12" Click="QuickSwitch_Click"/>
                                        <CheckBox x:Name="QuickWindowsSwitch" Content="Open ClipShot with Windows" Style="{StaticResource SwitchToggle}" Margin="0,0,0,12" Click="QuickSwitch_Click"/>
                                        <CheckBox x:Name="QuickTrickshotSwitch" Content="Clip Fortnite trickshots automatically" Style="{StaticResource SwitchToggle}" Margin="0,0,0,12" Click="QuickSwitch_Click"/>
                                        <CheckBox x:Name="QuickScreenshotSwitch" Content="Trickshot screenshots" Style="{StaticResource SwitchToggle}" Margin="0,0,0,12" Click="QuickSwitch_Click"/>
                                        <CheckBox x:Name="QuickMicSwitch" Content="Record microphone" Style="{StaticResource SwitchToggle}" Margin="0,0,0,10" Click="QuickSwitch_Click"/>
                                        <Button Content="All settings →" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="SettingsNav_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ClipsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel><TextBlock Text="My Clips" FontSize="28" FontWeight="Bold"/><TextBlock Text="Double-click a clip to watch it. Clips are saved in your Videos folder." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Screenshot" Style="{StaticResource SecondaryButton}" Click="ClipScreenshot_Click" Margin="0,0,10,0" ToolTip="Select a clip first, then pick the exact moment to save as a picture"/><Button Content="Rename" Style="{StaticResource SecondaryButton}" Click="RenameClip_Click" Margin="0,0,10,0" ToolTip="Select a clip first, then click Rename"/><Button Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshClips_Click" Margin="0,0,10,0"/><Button Content="Open folder" Style="{StaticResource PrimaryButton}" Click="OpenClipsFolder_Click"/></StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Trickshots" FontSize="18" FontWeight="SemiBold" Foreground="#F07178"/>
                                    <TextBlock Text="Wins where your final kill was with a sniper, found automatically and titled with the distance." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="TrickshotClipsList" Background="Transparent" BorderThickness="0" SelectionChanged="ClipList_SelectionChanged" MouseDoubleClick="ClipList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource ClipCardTemplate}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,18" Text="No trickshots yet. Win a match with a sniper final kill and ClipShot saves it here automatically. For other weapons, save a clip with your clip shortcut.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=TrickshotClipsList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="All clips" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,10"/>
                                <ListBox x:Name="OtherClipsList" Background="Transparent" BorderThickness="0" SelectionChanged="ClipList_SelectionChanged" MouseDoubleClick="ClipList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource ClipCardTemplate}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,18" Text="Nothing here yet. Press your clip shortcut while playing to save the last moments, or use long recording for full sessions.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=OtherClipsList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ScreenshotsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel><TextBlock Text="Screenshots" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="ScreenshotsSubtitle" Text="Saved in your Pictures folder, separate from your clips. Double-click one to open it." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshScreenshots_Click" Margin="0,0,10,0"/><Button Content="Open folder" Style="{StaticResource PrimaryButton}" Click="OpenScreenshotsFolder_Click"/></StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ListBox x:Name="ScreenshotsList" Background="Transparent" BorderThickness="0" MouseDoubleClick="ScreenshotsList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource ScreenshotCardTemplate}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock x:Name="ScreenshotsEmptyText" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,18" TextWrapping="Wrap"
                                           Text="No screenshots yet. Trickshots get one automatically, press F10 in game, or open a clip in My Clips and click Screenshot."/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="LeaderboardPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Your furthest shots" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="Your automatic trickshots, furthest first. Only shots ClipShot confirmed from the match itself count, so Meter Checker results and manual clips aren't on here." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="Count bot kills" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox x:Name="LeaderboardBotsToggle" Style="{StaticResource SwitchToggle}" IsChecked="True" VerticalAlignment="Center" Checked="LeaderboardBots_Changed" Unchecked="LeaderboardBots_Changed"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl x:Name="LeaderboardList" ItemTemplate="{StaticResource LeaderboardRowTemplate}"/>
                                <TextBlock x:Name="LeaderboardEmptyText" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="0,4,0,18" TextWrapping="Wrap"
                                           Text="No trickshots yet. Win a match with a sniper final kill and it shows up here, furthest first."/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="ReplayAnalyzerPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Meter Checker" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Open any Fortnite replay to see how far its final and furthest kills were." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,22,0,16">
                            <StackPanel>
                                <TextBlock Text="Choose a local replay" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="The replay stays on this computer. ClipShot does not upload it and no API key is needed." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReplayPathBox" Style="{StaticResource InputStyle}" IsReadOnly="True" ToolTip="Where Fortnite keeps your match replays."/>
                                    <Button Grid.Column="1" Content="Choose replay" Style="{StaticResource SecondaryButton}" Click="BrowseReplay_Click" Margin="10,0,0,0"/>
                                    <Button x:Name="AnalyzeReplayButton" Grid.Column="2" Content="Analyze" Style="{StaticResource PrimaryButton}" Click="AnalyzeReplay_Click" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="ReplayAnalysisStatusText" Text="Select a .replay file to begin." Foreground="#A1A1AA" FontSize="11" Margin="0,11,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="ReplayResultCard" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="FinalKillCard" Grid.Column="0" Margin="0,0,8,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="◎" Foreground="#E5484D" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Final Kill" Foreground="#E5484D" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Distance" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FinalKillDistanceText" Text="—" FontWeight="SemiBold" Foreground="#E5484D" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Killer" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FinalKillKillerText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Victim" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FinalKillVictimText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Weapon" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <StackPanel HorizontalAlignment="Right" Margin="90,0,0,0">
                                                <TextBlock x:Name="FinalKillWeaponText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                                <Button x:Name="FinalKillNameWeaponButton" Content="Name this weapon" Style="{StaticResource LinkButton}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="Collapsed" Click="NameWeapon_Click"
                                                        ToolTip="ClipShot doesn't know this weapon yet. Give it its real name once and it's remembered."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Shot" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FinalKillShotText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" Margin="90,0,0,0" TextAlignment="Right"
                                                       ToolTip="For snipers: whether the shot was scoped in or a no-scope."/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9">
                                        <Grid>
                                            <TextBlock Text="Rarity" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FinalKillRarityText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="FurthestKillCard" Grid.Column="1" Margin="8,0,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="↗" Foreground="#E5484D" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Furthest Kill" Foreground="#E5484D" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Distance" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FurthestKillDistanceText" Text="—" FontWeight="SemiBold" Foreground="#E5484D" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Killer" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FurthestKillKillerText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Victim" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FurthestKillVictimText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Weapon" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <StackPanel HorizontalAlignment="Right" Margin="90,0,0,0">
                                                <TextBlock x:Name="FurthestKillWeaponText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                                <Button x:Name="FurthestKillNameWeaponButton" Content="Name this weapon" Style="{StaticResource LinkButton}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="Collapsed" Click="NameWeapon_Click"
                                                        ToolTip="ClipShot doesn't know this weapon yet. Give it its real name once and it's remembered."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="Shot" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FurthestKillShotText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" Margin="90,0,0,0" TextAlignment="Right"
                                                       ToolTip="For snipers: whether the shot was scoped in or a no-scope."/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,9">
                                        <Grid>
                                            <TextBlock Text="Rarity" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FurthestKillRarityText" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,18">
                            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Recording changes apply the next time the engine starts." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,22"/>

                            <!-- Recording: the settings players actually change. -->
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Recording" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="OptimizePerformanceButton" Content="Optimize for my PC" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OptimizeForGameplay_Click"
                                                ToolTip="Tests your graphics card and picks the smoothest settings."/>
                                    </Grid>
                                    <TextBlock Text="Not sure? Click Optimize for my PC, then Save settings." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Quality" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="EncoderPresetBox" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="EncoderSetting_Changed"><ComboBoxItem Content="Balanced (recommended)" Tag="balanced"/><ComboBoxItem Content="Higher quality" Tag="quality"/><ComboBoxItem Content="Smoother gameplay" Tag="performance"/><ComboBoxItem Content="Custom" Tag="custom"/></ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="Frame rate" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="FpsChoiceBox" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="FpsChoice_Changed"><ComboBoxItem Content="30 FPS (smoothest gameplay)" Tag="30"/><ComboBoxItem Content="60 FPS (smoother clips)" Tag="60"/></ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="Resolution" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="ResolutionBox" Style="{StaticResource DarkComboBoxStyle}"><ComboBoxItem Content="Full (native)" Tag="0"/><ComboBoxItem Content="1080p (recommended)" Tag="1080"/><ComboBoxItem Content="720p (lightest)" Tag="720"/></ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,18" HorizontalAlignment="Left" Width="320">
                                        <TextBlock Text="Clip size" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ClipSizeBox" Style="{StaticResource DarkComboBoxStyle}">
                                            <ComboBoxItem Content="Smaller files" Tag="small"/>
                                            <ComboBoxItem Content="Balanced (recommended)" Tag="balanced"/>
                                            <ComboBoxItem Content="Best quality (big files)" Tag="large"/>
                                            <ComboBoxItem Content="No limit (very big files)" Tag="off"/>
                                        </ComboBox>
                                        <TextBlock Text="A 2-minute 1080p 60 FPS clip is about 110 MB on Smaller, 180 MB on Balanced and 320 MB on Best quality. Applies the next time recording starts." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="ClipLengthValueText" DockPanel.Dock="Right" Text="90 seconds" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Clip length: how much is saved when you press the shortcut" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </DockPanel>
                                    <Slider x:Name="ClipLengthSlider" Style="{StaticResource DarkSlider}" Minimum="15" Maximum="180" TickFrequency="5" SmallChange="5" LargeChange="15" Value="90" ValueChanged="ClipLengthSlider_ValueChanged" Margin="0,0,0,14"/>

                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock x:Name="PostMatchValueText" DockPanel.Dock="Right" Text="15 seconds" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="After a win, keep recording for" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </DockPanel>
                                    <Slider x:Name="PostMatchSlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="60" TickFrequency="5" SmallChange="5" LargeChange="10" Value="15" ValueChanged="PostMatchSlider_ValueChanged"/>

                                    <TextBlock x:Name="PerformanceStatusText" Text="Hardware encoding and 1080p capture are recommended while gaming." Foreground="#A1A1AA" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Storage" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <TextBlock Text="Clip library folder" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ClipFolderBox" Style="{StaticResource InputStyle}" IsReadOnly="True" ToolTip="Where your clips and recordings are saved."/>
                                        <Button Grid.Column="1" Content="Choose folder" Style="{StaticResource SecondaryButton}" Click="BrowseClipFolder_Click" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Changing this location affects new clips. Existing clips are not moved automatically." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16"><TextBlock Text="Audio" FontSize="17" FontWeight="SemiBold"/><Button Content="Refresh devices" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="RefreshAudioDevices_Click"/></Grid>
                                    <StackPanel><CheckBox x:Name="GameAudioCheck" Content="Record game sound" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Sound device (leave on Default unless your game sound uses another headset or speaker)" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/><ComboBox x:Name="GameAudioDeviceBox" Style="{StaticResource DarkComboBoxStyle}" IsEditable="False" ToolTip="The speakers or headset your game sound plays through."/></StackPanel>
                                    <DockPanel Margin="0,18,0,2">
                                        <TextBlock x:Name="VolumeValueText" DockPanel.Dock="Right" Text="100%" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Game volume" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </DockPanel>
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="200" TickFrequency="5" SmallChange="5" LargeChange="25" Value="100" ValueChanged="VolumeSlider_ValueChanged"
                                            ToolTip="How loud the game is in saved clips. 100% is the same as in game."/>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,16"/>
                                    <CheckBox x:Name="MicrophoneCheck" Content="Record my microphone" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="MicrophoneOptions" IsEnabled="{Binding IsChecked, ElementName=MicrophoneCheck}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Microphone" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="MicrophoneDeviceBox" Style="{StaticResource DarkComboBoxStyle}" IsEditable="False"/>
                                        <DockPanel Margin="0,16,0,2">
                                            <TextBlock x:Name="MicVolumeValueText" DockPanel.Dock="Right" Text="100%" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Microphone volume" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                        </DockPanel>
                                        <Slider x:Name="MicVolumeSlider" Style="{StaticResource DarkSlider}" Minimum="0" Maximum="200" TickFrequency="5" SmallChange="5" LargeChange="25" Value="100" ValueChanged="VolumeSlider_ValueChanged"/>
                                        <TextBlock Text="Your voice is mixed into the clip with the game sound. Windows may ask you to allow microphone access." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AudioDeviceStatusText" Text="Scanning Windows playback devices..." Foreground="#A1A1AA" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                    
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Controls and automation" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <TextBlock Text="Manual clip shortcut" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HotkeyBox" Style="{StaticResource InputStyle}" IsReadOnly="True"/><Button x:Name="HotkeyCaptureButton" Grid.Column="1" Content="Set shortcut" Style="{StaticResource SecondaryButton}" Click="CaptureHotkey_Click" Margin="10,0,0,0"/></Grid>
                                    <TextBlock Text="Long recording shortcut (press once to start, again to stop)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LongHotkeyBox" Style="{StaticResource InputStyle}" IsReadOnly="True"/><Button x:Name="LongHotkeyCaptureButton" Grid.Column="1" Content="Set shortcut" Style="{StaticResource SecondaryButton}" Click="CaptureLongHotkey_Click" Margin="10,0,0,0"/></Grid>
                                    <TextBlock Text="Screenshot shortcut" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ShotHotkeyBox" Style="{StaticResource InputStyle}" IsReadOnly="True"/><Button x:Name="ShotHotkeyCaptureButton" Grid.Column="1" Content="Set shortcut" Style="{StaticResource SecondaryButton}" Click="CaptureShotHotkey_Click" Margin="10,0,0,0"/></Grid>
                                    <CheckBox x:Name="TrickshotScreenshotCheck" Content="Save a screenshot of every trickshot automatically" Foreground="White" Margin="0,0,0,4"/>
                                    <TextBlock Text="Saves one picture with the swag lines and one with the damage number." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,0,0,12" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="StartOnOpenCheck" Content="Start recording when ClipShot opens" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="StartWithWindowsCheck" Content="Open ClipShot when Windows starts (in the system tray)" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="FortniteOnlyCheck" Content="Only record while Fortnite is running" Foreground="White" Margin="0,4"/>
                                    <TextBlock Text="Off: ClipShot records whatever you play. Fortnite trickshot clips and the Meter Checker work either way." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,0,0,8" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="LocalReplayCheck" Content="Check each match for trickshots automatically" Foreground="White" Margin="0,8,0,4"/>
                                    <TextBlock Text="After a win, ClipShot checks the final kill and keeps the clip if it was a trickshot." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,0,0,5" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="KeepRejectedCheck" Content="Keep clips that do not qualify" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimize ClipShot to the system tray" Foreground="White" Margin="0,8,0,4"/>
                                    <TextBlock Text="When enabled, the minimize button hides ClipShot while capture continues. Double-click the tray icon to restore it." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="22,0,0,0" TextWrapping="Wrap"/>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14"/>
                                    <CheckBox x:Name="UpdatesCheck" Content="Check for updates when ClipShot opens" Foreground="White" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckUpdatesButton" Content="Check for updates now" Style="{StaticResource SecondaryButton}" Click="CheckUpdates_Click"/>
                                        <TextBlock x:Name="AppVersionText" Text="Version 1.0.0" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Advanced: technical settings most players never need. -->
                            <Button x:Name="AdvancedToggle" Content="Show advanced settings ▾" Click="AdvancedToggle_Click" HorizontalAlignment="Left" Margin="2,0,0,14" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}" Foreground="#F07178" FontSize="13" Background="Transparent"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Advanced" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Only change these if you know what they do. Optimize for my PC sets them for you." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                                            <TextBlock Text="FFmpeg path (the bundled copy is detected automatically)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FfmpegPathBox" Style="{StaticResource InputStyle}"/><Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Click="BrowseFfmpeg_Click" Margin="10,0,0,0"/><Button Grid.Column="2" Content="Auto configure" Style="{StaticResource SecondaryButton}" Click="AutoConfigureFfmpeg_Click" Margin="8,0,0,0"/></Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,14"><TextBlock Text="Video encoder" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="EncoderBox" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="EncoderSetting_Changed"><ComboBoxItem Content="CPU — H.264 (works everywhere)" Tag="libx264"/><ComboBoxItem Content="NVIDIA NVENC" Tag="h264_nvenc"/><ComboBoxItem Content="Windows Media Foundation" Tag="h264_mf"/><ComboBoxItem Content="AMD AMF" Tag="h264_amf"/><ComboBoxItem Content="Intel Quick Sync" Tag="h264_qsv"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Frame rate (custom value)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="FpsBox" Style="{StaticResource InputStyle}" TextChanged="FriendlySource_TextChanged"/></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,14"><TextBlock Text="Encoder options (filled automatically; choose Quality → Custom to edit)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="EncoderOptionsBox" Style="{StaticResource InputStyle}"/></StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,14"><TextBlock Text="Rolling buffer (seconds)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="BufferBox" Style="{StaticResource InputStyle}"/></StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,14"><TextBlock Text="Segment length (seconds)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="SegmentBox" Style="{StaticResource InputStyle}"/></StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Clip length (seconds)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="ClipLengthBox" Style="{StaticResource InputStyle}" TextChanged="FriendlySource_TextChanged"/></StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Post-match footage (seconds)" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="PostMatchBox" Style="{StaticResource InputStyle}" TextChanged="FriendlySource_TextChanged"/></StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="PrioritizeGameCheck" Content="Limit CPU encoder threads and priority (helps FPS with the CPU encoder)" Foreground="White" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Save settings" Padding="28,12" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
