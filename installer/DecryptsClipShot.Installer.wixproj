<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>DecryptsClipShot-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>..\dist\Installer\</OutputPath>
    <!-- These ICE rules assume a machine-wide installation. ClipShot is
         intentionally installed per-user under LocalAppData. ICE61 flags
         AllowSameVersionUpgrades, which is intentional. -->
    <!-- WiX v7 refuses to build until its Open Source Maintenance Fee (OSMF)
         EULA is accepted. Keeping this line means you accept it; it is free
         unless your projects using WiX earn US$10,000+ a year.
         https://docs.firegiant.com/wix/osmf/ -->
    <AcceptEula>wix7</AcceptEula>
    <!-- Release version, e.g. dotnet build -p:ClipShotVersion=1.2.0 -->
    <ClipShotVersion Condition="'$(ClipShotVersion)' == ''">1.0.0</ClipShotVersion>
    <DefineConstants>$(DefineConstants);ClipShotVersion=$(ClipShotVersion)</DefineConstants>
    <SuppressIces>ICE38;ICE43;ICE61;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <BindPath Include="..\dist\DecryptsClipShot">
      <BindName>Publish</BindName>
    </BindPath>
  </ItemGroup>
</Project>
